---
import '../styles/global.css';

interface Props {
  title?: string;
}
const { title = 'Wintergatan Video Catalog' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
     <link
    rel="icon"
    type="image/png"
    sizes="32x32"
    href={`${Astro.site?.pathname ?? ''}/favicons/favicon-32x32.png`}
  />

  <link
    rel="icon"
    type="image/png"
    sizes="16x16"
    href={`${Astro.site?.pathname ?? ''}/favicons/favicon-16x16.png`}
  />

  <link
    rel="apple-touch-icon"
    href={`${Astro.site?.pathname ?? ''}/favicons/apple-touch-icon.png`}
  />

  <link
    rel="manifest"
    href={`${Astro.site?.pathname ?? ''}/favicons/site.webmanifest`}
  />

  <link
    rel="shortcut icon"
    href={`${Astro.site?.pathname ?? ''}/favicons/favicon.ico`}
  />
    <script is:inline>
      (function(){
        var t = localStorage.getItem('theme');
        var dark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        var resolved = t === 'light' ? 'light' : t === 'dark' ? 'dark' : (dark ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', resolved);
      })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
  </body>
</html>
